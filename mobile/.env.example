# Copy this file to `.env.local` and fill in the real values from your Supabase project.
# `.env.local` is gitignored — never commit real credentials.
#
# Find these values in: Supabase Dashboard → your project → Project Settings → API.

# The HTTPS URL of your Supabase project. Looks like https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The anon / public key. A long JWT starting with `eyJ...`.
# Public — ships in the mobile bundle. The service_role key is the secret one; do not put it here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
